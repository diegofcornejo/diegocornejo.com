{
	"rewrites": [
		{
			"source": "/",
			"has": [{ "type": "host", "value": "diegocornejo.com" }],
			"destination": "/home.html"
		},
		{
			"source": "/",
			"has": [{ "type": "host", "value": "www.diegocornejo.com" }],
			"destination": "/home.html"
		},
		{
			"source": "/dani",
			"destination": "/dani.html"
		},
		{
			"source": "/(.*)",
			"destination": "/api/index.js"
		}
	],
	"outputDirectory": "public"
}
